[Unit]
Description=SSHGuard Read-Only Dashboard API
Documentation=https://github.com/thorestic/SSHGuard
After=network-online.target sshguard-project.service
Wants=network-online.target

[Service]
Type=simple
User=mc
Group=mc
WorkingDirectory=/opt/sshguard/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SSHGUARD_DATABASE_PATH=/var/lib/sshguard/sshguard.db
Environment=SSHGUARD_WEB_DIST_PATH=/opt/sshguard/current/dashboard/web/dist
ExecStart=/opt/sshguard/current/.venv/bin/python -m uvicorn dashboard.api.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/sshguard /var/lib/sshguard
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target

