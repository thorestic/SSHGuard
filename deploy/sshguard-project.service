[Unit]
Description=SSHGuard Brute-Force Detection and Automatic Blocking System
Documentation=https://github.com/thorestic/SSHGuard
After=network-online.target ssh.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=mc
WorkingDirectory=/opt/sshguard/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SSHGUARD_DATABASE_PATH=/var/lib/sshguard/sshguard.db
Environment=SSHGUARD_LOG_PATH=/var/log/sshguard/sshguard.log
ExecStart=/opt/sshguard/current/.venv/bin/python /opt/sshguard/current/main.py

Restart=on-failure
RestartSec=3
UMask=0027
StateDirectory=sshguard
StateDirectoryMode=0750
LogsDirectory=sshguard
LogsDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/sshguard
ReadWritePaths=/var/lib/sshguard /var/log/sshguard

[Install]
WantedBy=multi-user.target
